# ChatFlow AI — Client Environment Variables
# Copy this file to .env.local to configure your real Firebase project.
# Do NOT commit .env or .env.local to version control.

# Firebase Web SDK Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Cloudflare Worker API (Phase 1A/1B)
VITE_WORKER_API_URL=http://localhost:8787
