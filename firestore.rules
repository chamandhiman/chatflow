rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
         get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid)
      );
    }

    function getWorkspaceRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function isWorkspaceAdminOrOwner(workspaceId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
         get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
         (getWorkspaceRole(workspaceId) == 'Owner' || getWorkspaceRole(workspaceId) == 'Admin'))
      );
    }

    // User profiles: each user can only read and update their own document
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId) && request.resource.data.id == userId;
      allow update: if isUser(userId);
      allow delete: if false;
    }

    // Workspaces root
    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isWorkspaceAdminOrOwner(workspaceId);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Workspace Members subcollection
      match /members/{memberId} {
        allow read: if isWorkspaceMember(workspaceId);
        // Initial owner can create their own member record; admins/owners can add other members
        allow create: if isAuthenticated() && (
          (request.auth.uid == memberId && request.resource.data.role == 'Owner' &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid) ||
          isWorkspaceAdminOrOwner(workspaceId)
        );
        allow update, delete: if isWorkspaceAdminOrOwner(workspaceId);
      }

      // Chatbots
      match /chatbots/{chatbotId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update, delete: if isWorkspaceMember(workspaceId);
      }

      // Knowledge Sources
      match /knowledgeSources/{sourceId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update, delete: if isWorkspaceMember(workspaceId);
      }

      // Conversations & Messages
      match /conversations/{conversationId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update: if isWorkspaceMember(workspaceId);
        allow delete: if isWorkspaceAdminOrOwner(workspaceId);

        match /messages/{messageId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow create, update: if isWorkspaceMember(workspaceId);
          allow delete: if isWorkspaceAdminOrOwner(workspaceId);
        }
      }

      // Leads
      match /leads/{leadId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update: if isWorkspaceMember(workspaceId);
        allow delete: if isWorkspaceAdminOrOwner(workspaceId);
      }

      // Usage records (Client read-only; writes reserved for trusted Cloudflare Worker backend)
      match /usageRecords/{recordId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if false;
      }
    }
  }
}
